{
  "name": "Address",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "enum": [
        "home",
        "work",
        "other"
      ],
      "default": "home"
    },
    "full_address": {
      "type": "string"
    },
    "landmark": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "pincode": {
      "type": "string"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "full_address",
    "city"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}